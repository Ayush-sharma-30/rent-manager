ENV=local

# DB & cache (defaults match docker-compose service names)
DATABASE_URL=postgresql+asyncpg://rent:rent@postgres:5432/rent_manager
DATABASE_SYNC_URL=postgresql+psycopg2://rent:rent@postgres:5432/rent_manager
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=90

# Dev OTP — any owner can log in with this value while ENV != production
OTP_FIXED=123456

# Stubs are on by default — set to true and fill the rest once you have real accounts
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

SES_ENABLED=false
SES_FROM_EMAIL=noreply@rentmanager.in

RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CORS_ALLOWED_ORIGINS=*
LOG_LEVEL=INFO
